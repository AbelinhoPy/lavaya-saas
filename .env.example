# URL base del sitio (en desarrollo http://localhost:3100; en Vercel https://tu-subdominio.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Base de datos Neon PostgreSQL (Servidor Serverless)
# NUNCA exponer con el prefijo NEXT_PUBLIC_
# Formato: postgres://[usuario]:[password]@[endpoint-neon].pooler.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secreto para sesiones seguras de autenticación (Better Auth / Servidor)
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Configuración de cobros con Paddle (Merchant of Record)
# Mantener sandbox hasta completar la verificación de la cuenta de comerciante y el método de retiro
PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Precios confirmados con 7 días gratis y tarjeta requerida en Paddle
# Mensual: US$20 cada mes (amount: 2000 cents)
PADDLE_PRICE_ID_MONTHLY=
# Semestral: US$108 cada 6 meses (amount: 10800 cents, eq. US$18/mes)
PADDLE_PRICE_ID_SEMIANNUAL=
# Anual: US$192 cada 12 meses (amount: 19200 cents, eq. US$16/mes)
PADDLE_PRICE_ID_ANNUAL=

# Por seguridad, BILLING_ENABLED permanece en false hasta validar sandbox y retiros
BILLING_ENABLED=false
